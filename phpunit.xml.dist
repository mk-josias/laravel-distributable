<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>packages/core/tests/Feature</directory>
            <directory>packages/rpc-http/tests/Feature</directory>
            <directory>packages/stream-redis/tests/Feature</directory>
            <directory>packages/stream-in-process/tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>packages/core/tests/Integration</directory>
            <directory>packages/rpc-http/tests/Integration</directory>
            <directory>packages/core/tests/Fixtures/apps/Analytics/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/rpc-http/src</directory>
            <directory>packages/stream-redis/src</directory>
            <directory>packages/stream-in-process/src</directory>
        </include>
    </source>
</phpunit>
