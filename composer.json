{
    "name": "mk-josias/laravel-distributable-modules-monorepo",
    "description": "Development of laravel-distributable-modules and its starter; packages/core and starter/ are each published on their own.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "mk-josias/laravel-microservices": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/octane": "^2.20",
        "laravel/pint": "^1.0",
        "mk-josias/laravel-microservices-http-rpc": "^0.1",
        "mk-josias/laravel-microservices-queue-stream": "^0.1",
        "mk-josias/laravel-microservices-redis-stream": "^0.1",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "repositories": {
        "microservices": {
            "type": "path",
            "url": "../laravel-microservices/packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "mk-josias/laravel-microservices": "0.1.0"
                }
            }
        },
        "http-rpc": {
            "type": "path",
            "url": "../laravel-microservices/packages/http-rpc",
            "options": {
                "symlink": true,
                "versions": {
                    "mk-josias/laravel-microservices-http-rpc": "0.1.0"
                }
            }
        },
        "redis-stream": {
            "type": "path",
            "url": "../laravel-microservices/packages/redis-stream",
            "options": {
                "symlink": true,
                "versions": {
                    "mk-josias/laravel-microservices-redis-stream": "0.1.0"
                }
            }
        },
        "queue-stream": {
            "type": "path",
            "url": "../laravel-microservices/packages/queue-stream",
            "options": {
                "symlink": true,
                "versions": {
                    "mk-josias/laravel-microservices-queue-stream": "0.1.0"
                }
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Distributable\\": "packages/core/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Distributable\\Tests\\": "packages/core/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Distributable\\Providers\\DistributableServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
