{
    "name": "mk-josias/laravel-distributable-stream-queue",
    "description": "Laravel queue driver for the events of mk-josias/laravel-distributable, for a stack without Redis: one queue per service; order is not kept after a failure.",
    "homepage": "https://mk-josias.github.io/laravel-microservices/",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "microservices",
        "events",
        "queue"
    ],
    "authors": [
        {
            "name": "Josias Mekontso",
            "email": "josiasmekontso.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "mk-josias/laravel-distributable": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Distributable\\Stream\\Queue\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Distributable\\Stream\\Queue\\StreamQueueServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
