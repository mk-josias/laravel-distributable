{
    "name": "mk-josias/laravel-distributable-stream-redis",
    "description": "Redis Streams driver for the events of mk-josias/laravel-distributable: one ordered stream, a consumer group per service, failed entries retried before later ones, or dropped.",
    "homepage": "https://mk-josias.github.io/laravel-microservices/",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "microservices",
        "events",
        "stream-rediss"
    ],
    "authors": [
        {
            "name": "Josias Mekontso",
            "email": "josiasmekontso.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "mk-josias/laravel-distributable": "self.version"
    },
    "suggest": {
        "ext-redis": "PhpRedis client (predis/predis works too)"
    },
    "autoload": {
        "psr-4": {
            "Distributable\\Stream\\Redis\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Distributable\\Stream\\Redis\\StreamRedisServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
