includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # Package code, plus the fixture application — the consumer side that actually uses the
    # package's traits and contracts, so analysing it covers both.
    # The Pest files themselves are out: Pest binds $this inside closures at runtime, which
    # static analysis cannot follow — running the suite is what verifies those.
    paths:
        - packages/core/src
        - packages/core/database
        - packages/core/tests/Fixtures
        - packages/core/tests/TestCase.php
        - packages/rpc-http/src
        - packages/rpc-http/tests/TestCase.php
        - packages/stream-redis/src
        - packages/stream-redis/tests/TestCase.php
        - packages/stream-queue/src
        - packages/stream-queue/tests/TestCase.php
