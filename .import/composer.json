{
    "name": "mk-josias/laravel-microservices-monorepo",
    "description": "Development of laravel-microservices and its drivers; each package under packages/ is published on its own.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Microservices\\": "packages/core/src/",
            "RpcHttp\\": "packages/rpc-http/src/",
            "StreamRedis\\": "packages/stream-redis/src/",
            "StreamQueue\\": "packages/stream-queue/src/"
        },
        "files": [
            "packages/core/src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Microservices\\Tests\\": "packages/core/tests/",
            "RpcHttp\\Tests\\": "packages/rpc-http/tests/",
            "StreamRedis\\Tests\\": "packages/stream-redis/tests/",
            "StreamQueue\\Tests\\": "packages/stream-queue/tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
